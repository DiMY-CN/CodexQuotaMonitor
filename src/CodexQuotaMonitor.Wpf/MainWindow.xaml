<Window x:Class="CodexQuotaMonitor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Monitor Native"
        Width="260"
        Height="48"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Icon="Assets/CodexQuotaMonitor.ico"
        Background="#070B12"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing"
        MouseRightButtonUp="OnMouseRightButtonUp">
    <Border x:Name="OuterBorder"
            Background="#273449"
            BorderThickness="0"
            SnapsToDevicePixels="True">
        <Grid x:Name="RootGrid"
              Margin="1"
              Background="#0D131D" />
    </Border>
</Window>
